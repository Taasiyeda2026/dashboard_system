# Frontend (Vite build / local dev)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BASE=./

# Supabase Preview / hosting integrations may inject these without the VITE_ prefix
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional Next.js-style aliases (supported by supabase-client.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-off maintenance scripts only (never commit real keys)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets for SharePoint (server-side only; never prefix with VITE_)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_WEBHOOK_CLIENT_STATE=

# Playwright E2E (never commit real credentials — use GitHub Secrets in CI)
# Required secrets: E2E_USERNAME, E2E_PASSWORD, E2E_BASE_URL
E2E_USERNAME=
E2E_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:4173
E2E_START_PREVIEW=true
E2E_UPDATE_BASELINE=0
E2E_EXPECTED_SHA=
