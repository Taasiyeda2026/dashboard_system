{
  "name": "workspace",
  "version": "1.0.0",
  "description": "מערכת ניהול פנימית מבוססת:",
  "main": "sw.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild-dist.mjs",
    "preview": "vite preview",
    "test": "npm run check:changed",
    "test:all:legacy": "node --test tests/*.test.mjs",
    "check:changed": "node scripts/check_changed.mjs",
    "check:frontend": "node scripts/check_changed.mjs --frontend",
    "check:build": "npm run build",
    "check:pwa": "node --test tests/service-worker-pwa-cache.test.mjs",
    "check:ci-plan": "node --test tests/ci-check-plan.test.mjs",
    "ci:quick": "node scripts/check_changed.mjs --run-plan",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:smoke": "playwright test -c e2e/playwright.smoke.config.mjs",
    "test:e2e:baseline": "E2E_UPDATE_BASELINE=1 playwright test -c e2e/playwright.config.mjs e2e/tests/04-performance.spec.mjs",
    "test:e2e:helpers": "node --test tests/e2e-performance-helpers.test.mjs",
    "baseline:report": "node scripts/write-local-baseline-report.mjs",
    "build:workbook": "node scripts/build_system_dashboard_workbook.mjs",
    "sync:sheet-to-supabase:once": "node scripts/sync_supabase_from_sheets_once.mjs",
    "migrate:users-to-auth:once": "node scripts/migrate_users_to_auth_once.mjs",
    "sync:catalog-to-pricing": "node scripts/sync_catalog_workshops_to_pricing.mjs",
    "sync:catalog-to-pricing:dry": "SYNC_DRY_RUN=1 node scripts/sync_catalog_workshops_to_pricing.mjs",
    "verify:scheduling:production": "node scripts/verify-scheduling-production-contract.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "vite": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3"
  }
}
